---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';

// Import necessary images
import sushka from '@/assets/images/optimized/proizvodstvo-kedr-brevna.webp';
import cnc from '@/assets/images/optimized/stroyka-karkas.webp';
import sborka from '@/assets/images/optimized/stroyka-krysha.webp';
import dom from '@/assets/images/optimized/ladniy-exterior-1.webp';
import { SITE } from '@data/constants';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Камерная сушка до 12%',
    subTitle:
      'Собственная сушка древесины. Дерево не ведёт, нет щелей и усадки. Дом держит тепло даже при −40°C — строим один раз и на поколения.',
    single: false,
    imgOne: sushka,
    imgOneAlt: 'Камерная сушка древесины',
    imgTwo: cnc,
    imgTwoAlt: 'Заводское производство',
  },
  {
    isRightSection: false,
    title: 'Завод и ЧПУ вместо диких бригад',
    subTitle:
      'Детали режем на ЧПУ на заводе с точностью до миллиметра. Усиленный каркас, утеплитель 200 мм, тройные энергосберегающие стеклопакеты, потолки ~3 м.',
    img: cnc,
    imgAlt: 'Производство деталей на ЧПУ',
    btnExists: true,
    btnTitle: 'Смотреть каталог',
    btnURL: '/catalog',
  },
  {
    isRightSection: true,
    title: 'Сборка на участке за 10 дней',
    subTitle:
      'На участок приезжает готовый домокомплект — только сборка под ключ. От договора до чаепития на террасе — от 10 дней, без скрытых расходов.',
    single: false,
    imgOne: sborka,
    imgOneAlt: 'Сборка дома на участке',
    imgTwo: dom,
    imgTwoAlt: 'Готовый дом МорошкаЛес',
  },
  {
    isRightSection: false,
    title: 'Живи зимой без доплат',
    subTitle:
      'Сэндвич-панели 200 мм, утеплённая кровля, инженерия под ключ. Капитальные дома для постоянного проживания — от 31 до 162 м².',
    img: dom,
    imgAlt: 'Дом МорошкаЛес зимой',
    btnExists: true,
    btnTitle: 'Подобрать дом',
    btnURL: '/quiz',
  },
];

const pageTitle: string = `Как мы строим | ${SITE.title}`;
const metaDescription =
  'Заводские дома МорошкаЛес: камерная сушка до 12%, ЧПУ, сборка под ключ за 10 дней. Без щелей, усадки и скрытых расходов.';
const ogTitle = `Как мы строим | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://moroshka-les.ru/services',
    url: 'https://moroshka-les.ru/services',
    name: `Как мы строим | ${SITE.title}`,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://moroshka-les.ru',
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'ru-RU',
  }}
>
  <MainSection
    title="Заводское качество против диких бригад"
    subTitle="Камерная сушка, ЧПУ и сборка под ключ за 10 дней. Без щелей, усадки и скрытых расходов."
    btnExists={true}
    btnTitle="Каталог домов"
    btnURL="/catalog"
  />
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <FeaturesStats
    title="Цифры"
    subTitle="Заводское качество, которое видно сразу — в щелях, которых нет, и в тепле, которое держится."
    mainStatTitle="10 дней"
    mainStatSubTitle="от договора до заселения — сборка под ключ"
    stats={[
      {
        stat: '12%',
        description: 'влажность древесины после камерной сушки',
      },
      {
        stat: '200 мм',
        description: 'утепления и тройные стеклопакеты',
      },
      {
        stat: '7',
        description: 'моделей — от 31 до 162 м²',
      },
    ]}
  />
</MainLayout>
