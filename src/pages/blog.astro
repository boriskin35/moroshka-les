---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Наш блог';
const subTitle =
  'Всё о домах, которые строят один раз и надолго. Разбираемся в материалах, технологиях, проектах, стоимости и строительстве — от выбора модели до заселения.';
---

<MainLayout
  title={`${title} | ${SITE.title}`}
  customDescription={subTitle}
  customOgTitle={title}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE.url}/blog`,
    url: `${SITE.url}/blog`,
    name: title,
    description: subTitle,
    inLanguage: 'ru-RU',
  }}
>
  <div class="w-full py-10 lg:py-14">
    <h1
      class="font-serif text-[24px] font-normal uppercase leading-snug text-neutral-800 dark:text-neutral-200"
    >
      НАШ <span class="text-accent">БЛОГ</span>
    </h1>
    <p class="mt-2 max-w-[50rem] text-neutral-600 dark:text-neutral-400">
      {subTitle}
    </p>
    <section class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6">
      {
        posts.map(post => (
          <a
            href={`/blog/${post.id}/`}
            class="group hover:border-accent block overflow-hidden rounded-xl border border-neutral-200 bg-white transition-transform duration-300 hover:scale-[1.02] dark:border-neutral-700 dark:bg-neutral-800"
          >
            {post.data.mainImage && (
              <div class="h-56 w-full overflow-hidden bg-neutral-100 dark:bg-neutral-700">
                <Image
                  src={post.data.mainImage}
                  alt={post.data.mainImageAlt || post.data.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  format="webp"
                />
              </div>
            )}
            <div class="p-6">
              <div class="text-sm text-neutral-500">
                {post.data.pubDate.toLocaleDateString('ru-RU')}
              </div>
              <h3 class="font-sans text-[22px] font-bold leading-snug text-accent mt-2">
                {post.data.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-neutral-600 dark:text-neutral-400">
                {post.data.description}
              </p>
              <span class="text-accent mt-4 inline-block font-normal transition group-hover:font-bold">
                Читать{' '}
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </section>
  </div>
</MainLayout>
