---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'Блог МорошкаЛес';
const subTitle = 'Всё о домах, которые строят один раз и надолго. Разбираемся в материалах, технологиях, проектах, стоимости и строительстве — от выбора модели до заселения.';
---
<MainLayout
  title={`${title} | ${SITE.title}`}
  customDescription={subTitle}
  customOgTitle={title}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE.url}/blog`,
    url: `${SITE.url}/blog`,
    name: title,
    description: subTitle,
    inLanguage: 'ru-RU',
  }}
>
  <div class="w-full py-10 lg:py-14">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200">Блог <span class="text-accent">МорошкаЛес</span></h1>
    <p class="mt-2 max-w-[50rem] text-neutral-600 dark:text-neutral-400">{subTitle}</p>
    <section class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6">
      {posts.map(post => (
        <a href={`/blog/${post.id}/`} class="group block rounded-xl border border-neutral-200 bg-white p-6 transition-transform duration-300 hover:scale-[1.02] hover:border-accent dark:border-neutral-700 dark:bg-neutral-800">
          <div class="text-sm text-neutral-500">{post.data.pubDate.toLocaleDateString('ru-RU')}</div>
          <h2 class="mt-2 text-xl font-bold text-accent">{post.data.title}</h2>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">{post.data.description}</p>
          <span class="mt-4 inline-block font-normal text-accent transition group-hover:font-bold">Читать <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></span>
        </a>
      ))}
    </section>
  </div>
</MainLayout>
