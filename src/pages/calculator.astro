---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const title = 'Калькулятор стоимости';
const subTitle = 'Предварительный расчет стоимости и ипотеки для вашего будущего дома.';
---
<MainLayout
  title={`${title} | ${SITE.title}`}
  customDescription={subTitle}
>
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h1 class="text-3xl font-bold text-neutral-800 sm:text-4xl dark:text-neutral-200">
        {title}
      </h1>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm p-6 sm:p-8 dark:bg-neutral-800 dark:border-neutral-700">
      <div class="text-center py-8">
        <svg class="w-16 h-16 mx-auto text-neutral-400 dark:text-neutral-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-2">Точная стоимость — по запросу</h2>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">
          Мы обновляем прайс-лист для обеспечения максимальной точности. Пожалуйста, свяжитесь с нами для получения актуального расчета для выбранной модели.
        </p>
        <a href="/contact" class="inline-flex justify-center items-center gap-x-3 text-center bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded-lg px-6 py-3 transition">
          Оставить заявку на расчет
        </a>
      </div>
    </div>
  </div>
</MainLayout>
