---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const title = 'B2B решения';
const subTitle =
  'Любой объем любой сложности с доставкой и монтажом по ХМАО. Глэмпинги, базы отдыха, коттеджные посёлки под ключ.';
---

<MainLayout
  title={`${title} | ${SITE.title}`}
  customDescription={subTitle}
  customOgTitle={title}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/b2b`,
    url: `${SITE.url}/b2b`,
    name: title,
    description: subTitle,
    inLanguage: 'ru-RU',
  }}
>
  <div class="mx-auto w-full max-w-3xl py-10 lg:py-14">
    <h1
      class="font-serif text-[24px] font-normal uppercase leading-snug text-neutral-800 dark:text-neutral-200"
    >
      <span class="text-accent">B2B</span> решения
    </h1>

    <p
      class="mt-6 text-lg font-bold text-neutral-800 dark:text-neutral-200"
    >
      Любой объем любой сложности с доставкой и монтажом по ХМАО.
    </p>

    <p class="mt-4 text-neutral-600 dark:text-neutral-400">
      Компания МорошкаЛес создаёт архитектурные решения для частного
      проживания и коммерческого успеха. Мы возводим объекты, которые
      приносят доход: от уютных глэмпингов и современных баз отдыха до
      премиальных коттеджных посёлков под ключ.
    </p>

    <ul
      class="mt-6 space-y-3 text-neutral-600 dark:text-neutral-400"
    >
      <li class="flex items-start gap-3">
        <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
        <span>
          <strong class="font-bold text-neutral-800 dark:text-neutral-200"
            >Глэмпинги и эко-отели</strong
          > — проекты для быстроокупаемого гостиничного бизнеса в гармонии с
          природой.
        </span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
        <span>
          <strong class="font-bold text-neutral-800 dark:text-neutral-200"
            >Базы отдыха и спортивно-оздоровительные комплексы</strong
          > — от концепции до ввода в эксплуатацию.
        </span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
        <span>
          <strong class="font-bold text-neutral-800 dark:text-neutral-200"
            >Коттеджные посёлки</strong
          > — «под ключ»: от планировки территории и инфраструктуры до
          строительства каждого дома.
        </span>
      </li>
    </ul>

    <p
      class="mt-6 font-bold text-neutral-800 dark:text-neutral-200"
    >
      Мы берём на себя весь цикл: проектирование, согласование,
      строительство и сдачу объекта, готового к работе и приносящему прибыль.
    </p>

    <div class="mt-8">
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-xl bg-accent px-8 py-3.5 text-center text-sm font-bold uppercase tracking-wider text-white shadow-md transition duration-200 hover:bg-accent-hover active:bg-accent-hover focus-visible:ring-3 focus-visible:ring-accent outline-hidden"
      >
        Оставить заявку
      </a>
    </div>
  </div>
</MainLayout>
