---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const houses = await getCollection('houses');
  return houses.map(house => ({
    params: { slug: house.id },
    props: { house },
  }));
}

const { house } = Astro.props;

const pageTitle = `${house.data.title} | ${SITE.title}`;
const metaDescription = house.data.description;
const ogTitle = pageTitle;
const houseSlug = house.id;
const areaNum = parseFloat(String(house.data.area).replace(',', '.').replace(/[^\d.]/g, '')) || 0;
---
<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${SITE.url}/catalog/${houseSlug}`,
    name: house.data.title,
    description: house.data.description,
    brand: {
      '@type': 'Brand',
      name: 'МорошкаЛес',
    },
  }}
>
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16">
      <div class="w-full">
        <Image
          src={house.data.mainImage}
          alt={house.data.mainImageAlt}
          class="w-full h-auto rounded-xl object-cover"
        />
      </div>
      <div class="flex flex-col justify-center">
        <h1 class="text-3xl font-bold text-neutral-800 sm:text-4xl lg:text-5xl dark:text-neutral-200">
          {house.data.title}
        </h1>
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          {house.data.description}
        </p>
        <div class="mt-8 grid grid-cols-2 gap-4">
          <div class="p-4 bg-neutral-100 rounded-lg dark:bg-neutral-800">
            <span class="block text-sm text-neutral-500">Площадь</span>
            <span class="block text-lg font-bold text-neutral-800 dark:text-neutral-200">{house.data.area}</span>
          </div>
          <div class="p-4 bg-neutral-100 rounded-lg dark:bg-neutral-800">
            <span class="block text-sm text-neutral-500">Спальни</span>
            <span class="block text-lg font-bold text-neutral-800 dark:text-neutral-200">{house.data.bedrooms}</span>
          </div>
          <div class="p-4 bg-neutral-100 rounded-lg dark:bg-neutral-800 col-span-2">
            <span class="block text-sm text-neutral-500">Особенности</span>
            <span class="block text-lg font-bold text-neutral-800 dark:text-neutral-200">{house.data.features}</span>
          </div>
        </div>
        <div class="mt-8 flex gap-4">
          <a href="#calc" class="inline-flex justify-center items-center gap-x-3 text-center uppercase bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded-lg px-6 py-3 transition">
            Рассчитать стоимость
          </a>
        </div>
        <div id="quiz-recommendations" class="hidden mt-10 p-6 bg-orange-50 border border-orange-200 rounded-xl dark:bg-neutral-800 dark:border-neutral-700" data-current-slug={houseSlug}>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">По результатам квиза вам также подходят:</h3>
          <div id="quiz-links" class="flex flex-wrap gap-3 mt-4"></div>
        </div>
      </div>
    </div>

    <div id="calc" class="mt-12 max-w-2xl mx-auto bg-white rounded-xl shadow-sm p-6 sm:p-8 dark:bg-neutral-800 dark:border-neutral-700" data-area={areaNum}>
      <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">Калькулятор стоимости</h2>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Предварительный расчёт для {house.data.title} ({house.data.area}). Точная стоимость — по запросу.</p>
      <div class="mt-6 grid gap-4">
        <label class="block">
          <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Цена за м², ₽</span>
          <input id="calc-price" type="number" value="85000" min="0" step="1000" class="mt-1 w-full rounded-lg border border-neutral-200 px-4 py-2 dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200" />
        </label>
        <label class="flex items-center gap-3 text-sm text-neutral-700 dark:text-neutral-300">
          <input type="checkbox" data-price="350000" class="calc-opt size-4 accent-orange-600" />
          Эксплуатируемая кровля (+350 000 ₽)
        </label>
        <label class="flex items-center gap-3 text-sm text-neutral-700 dark:text-neutral-300">
          <input type="checkbox" data-price="250000" class="calc-opt size-4 accent-orange-600" />
          Усиленное утепление (+250 000 ₽)
        </label>
        <label class="flex items-center gap-3 text-sm text-neutral-700 dark:text-neutral-300">
          <input type="checkbox" data-price="500000" class="calc-opt size-4 accent-orange-600" />
          Инженерия под ключ (+500 000 ₽)
        </label>
        <div class="mt-2 rounded-lg bg-neutral-100 p-4 dark:bg-neutral-900">
          <div class="text-sm text-neutral-500">Итого примерно:</div>
          <div id="calc-total" class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">—</div>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <label class="block">
            <span class="block text-xs text-neutral-500">Взнос, ₽</span>
            <input id="calc-down" type="number" value="1000000" min="0" step="50000" class="mt-1 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200" />
          </label>
          <label class="block">
            <span class="block text-xs text-neutral-500">Ставка, %</span>
            <input id="calc-rate" type="number" value="6" min="0" step="0.1" class="mt-1 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200" />
          </label>
          <label class="block">
            <span class="block text-xs text-neutral-500">Срок, лет</span>
            <input id="calc-years" type="number" value="20" min="1" max="30" step="1" class="mt-1 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200" />
          </label>
        </div>
        <div class="rounded-lg bg-neutral-100 p-4 dark:bg-neutral-900">
          <div class="text-sm text-neutral-500">Платёж по ипотеке примерно:</div>
          <div id="calc-monthly" class="text-xl font-bold text-neutral-800 dark:text-neutral-100">—</div>
          <p class="mt-2 text-xs text-neutral-500">Расчёт приблизительный, не оферта банка.</p>
        </div>
        <a href="/contact" class="inline-flex justify-center items-center rounded-lg uppercase bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover">Оставить заявку на расчёт</a>
      </div>
    </div>
  </div>

  <script>
    const houseNames: Record<string, string> = {
      "yasniy-den": "Дом-Терраса «Ясный день»",
      "rosa": "Дом Роса",
      "opushka": "Дом Опушка",
      "ladniy": "Ладный дом",
      "zhivica": "Дом-Баня Живица",
      "usadba": "Дом Усадьба",
      "sibirskiy-prostor": "Сибирский простор"
    };

    function fmt(n: number) {
      return n.toLocaleString('ru-RU') + ' ₽';
    }

    function updateCalc() {
      const root = document.getElementById('calc');
      const totalEl = document.getElementById('calc-total');
      const monthlyEl = document.getElementById('calc-monthly');
      if (!root || !totalEl || !monthlyEl) return;
      const area = parseFloat(root.getAttribute('data-area') || '0') || 0;
      const price = parseFloat((document.getElementById('calc-price') as HTMLInputElement)?.value || '0') || 0;
      let total = area * price;
      document.querySelectorAll('.calc-opt').forEach(el => {
        const cb = el as HTMLInputElement;
        if (cb.checked) total += parseFloat(cb.getAttribute('data-price') || '0') || 0;
      });
      totalEl.textContent = fmt(Math.round(total));
      const down = parseFloat((document.getElementById('calc-down') as HTMLInputElement)?.value || '0') || 0;
      const rate = parseFloat((document.getElementById('calc-rate') as HTMLInputElement)?.value || '0') || 0;
      const years = parseInt((document.getElementById('calc-years') as HTMLInputElement)?.value || '20') || 20;
      const p = Math.max(total - down, 0);
      const r = rate / 12 / 100;
      const n = years * 12;
      let monthly = 0;
      if (p > 0 && n > 0) {
        monthly = r > 0 ? p * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1) : p / n;
      }
      monthlyEl.textContent = fmt(Math.round(monthly)) + ' / мес';
    }

    document.addEventListener('DOMContentLoaded', () => {
      try {
        const stored = localStorage.getItem('moroshka_quiz_winners');
        if (stored) {
          const winners = JSON.parse(stored) as string[];
          const banner = document.getElementById('quiz-recommendations');
          const linksContainer = document.getElementById('quiz-links');
          if (banner && linksContainer) {
            const currentSlug = banner.getAttribute('data-current-slug');
            const otherWinners = winners.filter(w => w !== currentSlug);
            if (otherWinners.length > 0) {
              banner.classList.remove('hidden');
              otherWinners.forEach(slug => {
                const link = document.createElement('a');
                link.href = `/catalog/${slug}`;
                link.className = "inline-flex items-center gap-x-2 bg-white border border-neutral-200 text-neutral-800 hover:border-accent hover:text-accent text-sm font-medium rounded-lg px-4 py-2 transition dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200 dark:hover:border-accent";
                link.innerText = houseNames[slug] || slug;
                linksContainer.appendChild(link);
              });
            }
          }
        }
      } catch(e) {}
      ['calc-price','calc-down','calc-rate','calc-years'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', updateCalc);
      });
      document.querySelectorAll('.calc-opt').forEach(el => {
        el.addEventListener('change', updateCalc);
      });
      updateCalc();
    });
  </script>
</MainLayout>
