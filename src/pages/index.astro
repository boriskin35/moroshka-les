---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';

import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';

import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import heroImage from '@/assets/images/optimized/page_16_img_1.webp';
import faqs from '@data/faqs.json';

import construction from '@/assets/images/optimized/page_12_img_1.webp';
import tools from '@/assets/images/optimized/page_10_img_1.webp';
import dashboard from '@/assets/images/optimized/page_14_img_1.webp';


const avatarSrcs: Array<string> = [
  'https://ui-avatars.com/api/?name=А+В&background=random',
  'https://ui-avatars.com/api/?name=Е+С&background=random',
  'https://ui-avatars.com/api/?name=И+М&background=random',
  'https://ui-avatars.com/api/?name=О+К&background=random',
];
---

<MainLayout>

  <HeroSection
    title=`Строим один раз и <span class="text-accent">на поколения</span>`
    subTitle="Заводские дома и бани из кедра. Камерная сушка до 12%, ЧПУ, под ключ за 10 дней — без щелей и скрытых расходов."
    primaryBtn="Каталог домов"
    primaryBtnURL="/catalog"
    secondaryBtn="Подобрать дом"
    secondaryBtnURL="/quiz"
    withReview={true}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.9</span> / 5`
    starCount={5}
    reviews=`Более <span class="font-bold">200</span> семей уже живут в МорошкаЛес`
    src={heroImage}
    alt="Дом из кедра МорошкаЛес"
  />




  <FeaturesNavs
    title=`Технологии <span class="text-accent">МорошкаЛес</span>: качество в каждой детали`
    tabs={[
      {
        heading: 'Камерная сушка до 12%',
        content:
          'Собственная сушка — дерево не ведёт, без щелей и усадки. Держит тепло даже при −40°C.',
        svg: 'tools',
        src: tools,
        alt: 'Камерная сушка древесины',
        first: true,
      },
      {
        heading: 'ЧПУ-завод, 10 дней',
        content:
          'Детали режем на ЧПУ на заводе. На участке только сборка — от договора до чаепития на террасе 10 дней.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Заводское производство на ЧПУ',
        second: true,
      },
      {
        heading: '200 мм утепления',
        content:
          'Тройные стеклопакеты, высота потолков ~3 м, утеплённая кровля. Живи зимой без доплат за отопление.',
        svg: 'house',
        src: construction,
        alt: 'Каркас дома с утеплением 200 мм',
      },
    ]}
  />

  <TestimonialsSection
    title="Быстрый старт — 10 дней до заселения"
    subTitle="От договора до ключей — без месяцев ожидания и скрытых расходов."
    ;
    testimonials={[
      {
        content:
          'МорошкаЛес собрали наш Ладный дом за 10 дней. Тепло держит при −40, сборка без щелей — заводское качество видно сразу!',
        author: 'Семья Ивановых',
        role: 'Владельцы Ладного дома, 66.7 м²',
        avatarSrc:
          'https://ui-avatars.com/api/?name=С+И&background=133E22&color=fff',
      },
    ]}
    statistics={[
      {
        count: '7',
        description:
          'моделей — от 31 до 162 м²',
      },
      {
        count: '10 дней',
        description:
          'от договора до заселения',
      },
      {
        count: '200 мм',
        description:
          'утепления и тройные стеклопакеты',
      },
      {
        count: '~3 м',
        description: 'высота потолков',
      },
    ]}
  />

  <FAQ title="Частые<br />вопросы" faqs={faqs} />

  <HeroSectionAlt
    title="Давай строить вместе"
    subTitle="МорошкаЛес — заводские дома из кедра, готовые за 10 дней. Честно, надёжно, на поколения."
    url="/contact"
  />
</MainLayout>
