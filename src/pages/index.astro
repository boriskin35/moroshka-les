---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import heroImage from '@images/hero-image.avif';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import pricing from '@data/pricing.json';
import featureImage from '@images/features-image.avif';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';

const avatarSrcs: Array<string> = [
  'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
];
---

<MainLayout>

  <HeroSection
    title=`Строим один раз и <span class="text-accent">на поколения</span>`
    subTitle="Заводские дома и бани из кедра. Камерная сушка до 12%, ЧПУ, под ключ за 10 дней — без щелей и скрытых расходов."
    primaryBtn="Каталог домов"
    primaryBtnURL="/products"
    secondaryBtn="Подобрать дом"
    secondaryBtnURL="/products"
    withReview={true}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.9</span> / 5`
    starCount={5}
    reviews=`Более <span class="font-bold">200</span> семей уже живут в МорошкаЛес`
    src={heroImage}
    alt="Дом из кедра МорошкаЛес"
  />

  <ClientsSection
    title="Нам доверяют"
    subTitle="Выбирают те, кто строит один раз и надолго."
    partners={partnersData}
  />

  <FeaturesGeneral
    title="Почему МорошкаЛес"
    subTitle="Заводское качество против диких бригад. Делаем детали на ЧПУ, сушим до 12% — собираем на участке за дни, а не месяцы."
    src={featureImage}
    alt="Производство домов МорошкаЛес"
    features={features}
  />

  <FeaturesNavs
    title=`Подбери <span class="text-accent">МорошкаЛес</span> под свой участок и задачу`
    tabs={[
      {
        heading: 'Камерная сушка до 12%',
        content:
          'Собственная сушка — дерево не ведёт, без щелей и усадки. Держит тепло даже при −40°C.',
        svg: 'tools',
        src: tools,
        alt: 'Камерная сушка древесины',
        first: true,
      },
      {
        heading: 'ЧПУ-завод, 10 дней',
        content:
          'Детали режем на ЧПУ на заводе. На участке только сборка — от договора до чаепития на террасе 10 дней.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Заводское производство на ЧПУ',
        second: true,
      },
      {
        heading: '200 мм утепления',
        content:
          'Тройные стеклопакеты, высота потолков ~3 м, утеплённая кровля. Живи зимой без доплат за отопление.',
        svg: 'house',
        src: construction,
        alt: 'Каркас дома с утеплением 200 мм',
      },
    ]}
  />

  <TestimonialsSection
    title="Быстрый старт — 10 дней до заселения"
    subTitle="От договора до ключей — без месяцев ожидания и скрытых расходов."
    ;
    testimonials={[
      {
        content:
          'МорошкаЛес собрали наш Ладный дом за 10 дней. Тепло держит при −40, сборка без щелей — заводское качество видно сразу!',
        author: 'Семья Ивановых',
        role: 'Владельцы Ладного дома, 66.7 м²',
        avatarSrc:
          'https://images.unsplash.com/photo-1593104547489-5cfb3839a3b5?q=80&w=1453&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
      },
    ]}
    statistics={[
      {
        count: '7',
        description:
          'моделей — от 31 до 162 м²',
      },
      {
        count: '10 дней',
        description:
          'от договора до заселения',
      },
      {
        count: '200 мм',
        description:
          'утепления и тройные стеклопакеты',
      },
      {
        count: '~3 м',
        description: 'высота потолков',
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <FAQ title="Частые<br />вопросы" faqs={faqs} />

  <HeroSectionAlt
    title="Давай строить вместе"
    subTitle="МорошкаЛес — заводские дома из кедра, готовые за 10 дней. Честно, надёжно, на поколения."
    url="/contact"
  />
</MainLayout>
