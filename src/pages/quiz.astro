---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const title = 'Квиз: Подбор дома';
const subTitle = 'Ответьте на несколько вопросов, и мы подберем идеальный проект для вас.';
---
<MainLayout
  title={`${title} | ${SITE.title}`}
  customDescription={subTitle}
>
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h1 class="text-3xl font-bold text-neutral-800 sm:text-4xl dark:text-neutral-200">
        {title}
      </h1>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm p-6 sm:p-8 dark:bg-neutral-800 dark:border-neutral-700">
      <div id="quiz-container" class="space-y-6">
        <div id="question-area" class="text-xl font-medium text-neutral-800 dark:text-neutral-200 mb-6">
          <!-- Question gets injected here -->
        </div>
        <div id="options-area" class="grid gap-4">
          <!-- Options injected here -->
        </div>
      </div>
      <div id="result-area" class="hidden text-center py-8">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4">По вашим ответам вам идеально подходят эти варианты:</h2>
        <div id="result-houses" class="mt-8 space-y-4">
           <!-- Links injected here -->
        </div>
      </div>
    </div>
  </div>

  <script>
    const questions = [
      {
        text: "Для чего вам нужен дом?",
        options: [
          { text: "Постоянное проживание", house: "Ладный дом" },
          { text: "Дача на сезон", house: "Дом Опушка" },
          { text: "Дом-баня для отдыха", house: "Дом-Терраса «Ясный день»" },
          { text: "Коммерческий объект", house: "Сибирский простор" }
        ]
      },
      {
        text: "Сколько человек будет пользоваться домом?",
        options: [
          { text: "1-2 человека", house: "Дом Роса" },
          { text: "3-4 человека", house: "Ладный дом" },
          { text: "5 и более (большая семья)", house: "Дом Усадьба" }
        ]
      },
      {
        text: "Нужна ли вам баня?",
        options: [
          { text: "Да, отдельная", house: "Дом-Баня Живица" },
          { text: "Да, совмещенная с домом", house: "Дом Роса" },
          { text: "Нет, баня не нужна", house: "Дом Опушка" }
        ]
      }
    ];

    const houseSlugs: Record<string, string> = {
      "Дом-Терраса «Ясный день»": "yasniy-den",
      "Дом Роса": "rosa",
      "Дом Опушка": "opushka",
      "Ладный дом": "ladniy",
      "Дом-Баня Живица": "zhivica",
      "Дом Усадьба": "usadba",
      "Сибирский простор": "sibirskiy-prostor"
    };

    let currentStep = 0;
    const scores: Record<string, number> = {};

    function renderQuestion() {
      const qArea = document.getElementById('question-area');
      const optArea = document.getElementById('options-area');
      if(!qArea || !optArea) return;

      if (currentStep >= questions.length) {
        showResult();
        return;
      }

      const q = questions[currentStep];
      qArea.innerText = q.text;
      optArea.innerHTML = '';

      q.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left px-6 py-4 rounded-lg border border-neutral-200 hover:border-accent hover:bg-neutral-50 dark:border-neutral-700 dark:hover:border-accent dark:hover:bg-neutral-700 dark:text-neutral-200 transition-colors";
        btn.innerText = opt.text;
        btn.onclick = () => {
          scores[opt.house] = (scores[opt.house] || 0) + 1;
          currentStep++;
          renderQuestion();
        };
        optArea.appendChild(btn);
      });
    }

    function showResult() {
      document.getElementById('quiz-container')?.classList.add('hidden');
      const resArea = document.getElementById('result-area');
      const resHouses = document.getElementById('result-houses');
      if(resArea && resHouses) {
        resArea.classList.remove('hidden');
        
        let maxScore = -1;
        for (const score of Object.values(scores)) {
          if (score > maxScore) maxScore = score;
        }

        const winners: string[] = [];
        for (const [house, score] of Object.entries(scores)) {
          if (score === maxScore) winners.push(house);
        }

        if (winners.length === 0) winners.push("Ладный дом");

        // Save winners to localStorage for the Apple Magic cross-sell
        const winnerSlugs = winners.map(w => houseSlugs[w]).filter(Boolean);
        localStorage.setItem('moroshka_quiz_winners', JSON.stringify(winnerSlugs));

        resHouses.innerHTML = '';
        winners.forEach(winner => {
          const slug = houseSlugs[winner] || 'ladniy';
          const link = document.createElement('a');
          link.href = `/catalog/${slug}`;
          link.className = "flex w-full sm:w-auto sm:inline-flex justify-center items-center gap-x-3 text-center bg-accent hover:bg-accent-hover text-white text-lg font-medium rounded-lg px-8 py-4 transition shadow-md hover:shadow-lg sm:mr-4 mb-4";
          link.innerText = `Посмотреть ${winner}`;
          resHouses.appendChild(link);
        });
      }
    }

    document.addEventListener('DOMContentLoaded', renderQuestion);
  </script>
</MainLayout>
