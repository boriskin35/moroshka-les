---
const {
  label = 'Электронная почта',
  title = 'Подписаться',
  id = 'footer-input',
} = Astro.props;

interface Props {
  label?: string;
  title?: string;
  id?: string;
}

const placeholder = 'Введите email';
const successMessage =
  'Спасибо! (Демо — подключите почтовый сервис для реальных подписок.)';
---

<div
  class="mt-4 flex flex-col items-center gap-2 rounded-lg bg-neutral-800 p-2 sm:flex-row sm:gap-3"
>
  <div class="w-full">
    <label for={id} class="sr-only">{label}</label>
    <input
      type="email"
      id={id}
      name="email"
      required
      autocomplete="email"
      class="block w-full rounded-lg border-transparent bg-neutral-700 px-4 py-3 text-sm text-gray-300 caret-orange-400 placeholder:text-neutral-300 focus:border-orange-400 focus:ring-orange-400 disabled:pointer-events-none disabled:opacity-50"
      placeholder={placeholder}
    />
  </div>
  <button
    type="submit"
    class="bg-accent hover:bg-accent-hover inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent p-3 text-sm font-bold whitespace-nowrap text-neutral-50 ring-zinc-200 outline-hidden transition duration-300 focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 sm:w-auto dark:focus:ring-1 dark:focus:outline-hidden"
  >
    {title}
  </button>
</div>
<p
  class="mt-2 hidden text-sm text-neutral-400"
  data-demo-status
  aria-live="polite"
  data-success-message={successMessage}
>
</p>
