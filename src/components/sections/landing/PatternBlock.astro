---
import patternImg from '@/assets/images/optimized/wood-pattern.webp';
import planSvg from '@/assets/icons/advantages/plan.svg?raw';
import projectSvg from '@/assets/icons/advantages/project.svg?raw';
import thermoSvg from '@/assets/icons/advantages/thermo.svg?raw';
import priceSvg from '@/assets/icons/advantages/price.svg?raw';
import badgeSvg from '@/assets/icons/advantages/badge.svg?raw';
import speedSvg from '@/assets/icons/advantages/speed.svg?raw';
import ecoSvg from '@/assets/icons/advantages/eco.svg?raw';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const advantages = [
  {
    title: 'Продуманная планировка:',
    description:
      'Мы уже учли все мелочи и предлагаем только проверенные решения для комфортной жизни.',
    icon: 'plan',
    svg: planSvg,
  },
  {
    title: 'Индивидуальный проект:',
    description:
      'Мы создаём готовый проект, который вы можете реализовать самостоятельно, либо воспользоваться нашей помощью.',
    icon: 'project',
    svg: projectSvg,
  },
  {
    title: 'Теплый дом для ПМЖ:',
    description:
      'В наших домах не страшно жить даже на севере при температуре -40…-45 °C.',
    icon: 'thermo',
    svg: thermoSvg,
  },
  {
    title: 'Фиксированная цена:',
    description:
      'Фиксируемая стоимость в договоре без изменений на всех этапах строительства.',
    icon: 'price',
    svg: priceSvg,
  },
  {
    title: 'Гарантия качества:',
    description: 'Мы даем гарантию 5 лет на силовой каркас.',
    icon: 'badge',
    svg: badgeSvg,
  },
  {
    title: 'Быстрый монтаж:',
    description:
      'Ваш дом будет готов через 1 месяц благодаря собственному производству.',
    icon: 'speed',
    svg: speedSvg,
  },
  {
    title: 'Экологичность:',
    description:
      'В составе мы используем только натуральные хвойные материалы.',
    icon: 'eco',
    svg: ecoSvg,
  },
];
---

<section
  class:list={[
    'relative my-6 w-full overflow-hidden rounded-2xl shadow-sm lg:my-10 md:rounded-3xl',
    className,
  ]}
  style={`background-color: #133e22; background-image: url('${patternImg.src}'); background-repeat: repeat; background-size: 370px 370px;`}
  aria-label="Преимущества работы с Морошка Лес"
>
  <div class="relative z-10 px-4 py-8 sm:px-8 sm:py-10 lg:px-12 lg:py-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <!-- Левая колонка: Заголовок и вводный текст -->
      <div class="lg:col-span-4 xl:col-span-4">
        <div>
          <p
            class="mb-2 text-xs font-bold tracking-widest text-neutral-300 uppercase"
          >
            Почему мы
          </p>
          <h2
            class="font-serif text-[22px] font-normal uppercase text-white leading-snug"
          >
            <span class="text-white">Преимущества</span> работы с <span class="text-accent">МорошкаЛес</span>
          </h2>
          <p
            class="mt-4 text-base leading-relaxed text-neutral-200 sm:text-lg lg:mt-6"
          >
            Мы воплощаем ваши мечты в реальность, создавая модульные дома, в
            которых не страшно жить на севере. С нами каждый проект — это
            качество, прозрачная цена и современный подход.
          </p>
        </div>
      </div>

      <!-- Правая колонка: Список преимуществ в белых плашках -->
      <div class="flex flex-col gap-3.5 sm:gap-4 lg:col-span-8 xl:col-span-8">
        {
          advantages.map(item => (
            <div class="flex flex-col gap-3 rounded-2xl bg-white p-4 shadow-xs transition duration-200 hover:shadow-md sm:flex-row sm:items-start sm:gap-5 sm:p-5 lg:rounded-3xl">
              {/* Иконка */}
              <div
                class="text-accent flex h-12 w-12 shrink-0 items-center justify-center sm:mt-0.5 sm:h-14 sm:w-14"
                set:html={item.svg}
              />

              {/* Текстовое описание: заголовок и пояснение (ровно 50% на 50%) */}
              <div class="grid grid-cols-1 gap-2 text-sm leading-relaxed sm:grid-cols-2 sm:gap-2 sm:text-base w-full min-w-0 flex-1 items-start">
                <h3 class="font-sans text-[22px] font-bold text-neutral-900 leading-snug">
                  {item.title}
                </h3>
                <div class="text-neutral-700">
                  <p>{item.description}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
