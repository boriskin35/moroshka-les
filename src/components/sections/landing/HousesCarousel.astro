---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import patternImg from '@/assets/images/optimized/wood-pattern.webp';

const parseArea = (s: string) =>
  parseFloat(s.match(/\d+(?:[.,]\d+)?/)?.[0]?.replace(',', '.') || '0');
const houses = (await getCollection('houses')).sort(
  (a, b) => parseArea(a.data.area) - parseArea(b.data.area)
);
const loop = [...houses, ...houses];

const cleanTitle = (title: string) => title.replace(/[«»"“”]/g, '').trim();
const cardFooterStyle = `background-color: #133e22; background-image: url('${patternImg.src}'); background-repeat: repeat; background-size: 370px 370px;`;
---

<section class="w-full overflow-hidden py-6 lg:py-10">
  <div
    class="mx-auto mb-6 flex w-full max-w-(--breakpoint-2xl) items-end justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <div>
      <p
        class="mb-2 text-xs font-bold tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
      >
        Каталог
      </p>
      <h2
        class="font-serif text-[22px] leading-snug font-normal text-neutral-800 uppercase dark:text-neutral-200"
      >
        Наши дома
      </h2>
      <p
        class="mt-2 text-base text-neutral-600 md:text-lg dark:text-neutral-400"
      >
        Готовые решения для круглогодичной жизни и загородного отдыха.
      </p>
    </div>
    <a
      href="/catalog"
      class="group text-brand hover:text-brand/80 inline-flex shrink-0 items-center gap-x-2 text-base font-semibold transition duration-200"
    >
      <span>Все дома</span>
      <svg
        class="h-4 w-4 shrink-0 transition ease-in-out group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
      </svg>
    </a>
  </div>

  <div class="carousel overflow-hidden">
    <div class="carousel-track flex w-max">
      {
        loop.map((house, i) => (
          <a
            href={`/catalog/${house.id}/`}
            aria-hidden={i >= houses.length ? 'true' : undefined}
            tabindex={i >= houses.length ? '-1' : undefined}
            class="group border-brand mr-4 flex w-64 shrink-0 flex-col overflow-hidden rounded-2xl border bg-[#133e22] sm:w-72"
          >
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={house.data.mainImage}
                alt={house.data.mainImageAlt}
                class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                loading="lazy"
                format="webp"
              />
            </div>
            <div class="flex-1 p-4" style={cardFooterStyle}>
              <h3 class="font-serif text-[22px] leading-snug font-normal text-white uppercase">
                {cleanTitle(house.data.title)}
              </h3>
              <p class="mt-1 font-serif text-sm text-neutral-200">
                {house.data.area.split('(')[0].trim()}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .carousel-track {
    animation: carousel-scroll 40s linear infinite;
  }
  .carousel:hover .carousel-track {
    animation-play-state: paused;
  }
  @keyframes carousel-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }
  }
</style>
