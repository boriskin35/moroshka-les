---
import { Image } from 'astro:assets';

// Подключаем релевантные картинки по смыслу
import imgHouse from '@/assets/images/echo/echo-opushka-houses.jpg';
import imgWinter from '@/assets/images/echo/echo-winter-snowmobiles.jpg';
import imgBathhouse from '@/assets/images/echo/echo-zhivitsa-bathhouse.jpg';
import imgFirepit from '@/assets/images/echo/echo-firepit-gazebo.jpg';
import imgOutro from '@/assets/images/echo/echo-resort-aerial.webp';

const gridItems = [
  {
    title: 'Туристические дома «Опушка»',
    desc: 'Уютные дома для отдыха в любое время года.',
    img: imgHouse,
  },
  {
    title: 'Активный отдых',
    desc: 'Снегоходы, квадроциклы, прогулки по лесу и новые маршруты.',
    img: imgWinter,
  },
  {
    title: 'Дом-баня «Живица»',
    desc: 'Баня и дом в одном. Настоящее место силы.',
    img: imgBathhouse,
  },
  {
    title: 'Общие пространства',
    desc: 'Костровые зоны, беседки, прогулочные дорожки и природа вокруг.',
    img: imgFirepit,
  },
];
---

<section id="echo-complex" class="w-full">
  {/* Текстовый вводный блок (дает "воздух" после главного экрана) */}
  <div
    class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 py-16 sm:px-6 md:py-24 lg:px-8"
  >
    <div class="max-w-3xl">
      <span
        class="mb-2 block text-xs font-bold tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
      >
        Туристический курорт «ЭХО»
      </span>
      <h2
        class="mb-6 text-4xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        Место, где наши дома<br class="hidden md:block" /> становятся <span class="text-accent">реальностью</span>
      </h2>
      <p class="text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
        Мы построили Эхо не ради красивой картинки. Мы хотели пожить в своих
        домах, пережить зиму, посмотреть, как они ведут себя в реальных условиях
        — и только после этого предлагать их вам.
      </p>
    </div>
  </div>

  {/* Монолитная галерея (Bento Box) внутри контейнера для выравнивания */}
  <div class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
    <div class="grid w-full grid-cols-1 gap-0 md:grid-cols-4">
      {
        gridItems.map(item => (
          <div class="group relative aspect-[3/4] overflow-hidden md:aspect-[4/5] lg:aspect-[3/4]">
            <Image
              src={item.img}
              alt={item.title}
              class="h-full w-full object-cover"
              format="webp"
            />
            {/* Градиентное затемнение для читаемости текста */}
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent opacity-90" />

            <div class="absolute bottom-0 left-0 w-full p-6 text-white md:p-8">
              <h3 class="mb-3 text-xl font-bold md:text-2xl">{item.title}</h3>
              <p class="text-sm leading-relaxed text-neutral-200 md:text-base">
                {item.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    {/* Финальный широкий блок */}
    <div
      class="relative aspect-[3/4] w-full overflow-hidden sm:aspect-[16/9] md:aspect-[21/9]"
    >
      <Image
        src={imgOutro}
        alt="Больше, чем дома"
        class="h-full w-full object-cover object-center"
        format="webp"
      />
      <div
        class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent opacity-90"
      >
      </div>

      <div
        class="absolute bottom-0 left-0 w-full p-5 text-white sm:p-8 md:p-12 lg:max-w-4xl"
      >
        <h3
          class="mb-2 text-2xl font-bold sm:mb-4 sm:text-3xl md:text-4xl lg:text-5xl"
        >
          Больше, чем дома.
        </h3>
        <p
          class="text-sm leading-relaxed text-neutral-200 sm:text-base md:text-lg"
        >
          Эхо — это активный отдых, прогулки по лесу, свежий воздух и ощущение
          свободы в любое время года.
        </p>
      </div>
    </div>
  </div>
</section>
