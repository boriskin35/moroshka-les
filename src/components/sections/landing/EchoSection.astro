---
import { Image } from 'astro:assets';

// Подключаем релевантные картинки по смыслу
import imgPanorama from '@/assets/images/echo/echo-cabins-panorama.webp';
import imgAerial from '@/assets/images/echo/echo-aerial-overview.webp';
import imgWinter from '@/assets/images/echo/echo-winter-snowmobiles.webp';
import imgBathhouse from '@/assets/images/echo/echo-zhivitsa-bathhouse.webp';
import imgFirepit from '@/assets/images/echo/echo-firepit-rotunda.webp';

const gridItems = [
  {
    title: 'Лес и чистый воздух',
    img: imgAerial,
  },
  {
    title: 'Активный отдых',
    img: imgWinter,
  },
  {
    title: 'Дом-баня «Живица»',
    img: imgBathhouse,
  },
  {
    title: 'Общие пространства',
    img: imgFirepit,
  },
];
---

<section id="echo-complex" class="w-full">
  {/* Текстовый вводный блок (дает "воздух" после главного экрана) */}
  <div
    class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 pt-12 pb-6 sm:px-6 lg:pt-20 lg:pb-10 lg:px-8"
  >
    <div class="w-full">
      <span
        class="mb-2 block text-xs font-bold tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
      >
        Туристический курорт «ЭХО»
      </span>
      <h2
        class="font-serif text-[22px] font-normal uppercase text-neutral-800 leading-snug dark:text-neutral-200 mb-6"
      >
        Место, где наши дома становятся <span class="text-accent">реальностью</span>
      </h2>
      <p class="text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
        Сначала мы строим и проверяем дома на себе — потом предлагаем вам.
        Место, где наши дома становятся реальностью.
      </p>
    </div>
  </div>

  {/* Главная панорамная карточка во всю ширину блока */}
  <div class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 pb-6 sm:px-6 lg:pb-8 lg:px-8">
    <div class="relative block aspect-[16/9] w-full overflow-hidden rounded-2xl shadow-xs transition duration-300 hover:shadow-md md:rounded-3xl">
      <Image
        src={imgPanorama}
        alt="Дома в сосновом бору — курорт «ЭХО»"
        class="h-full w-full object-cover transition duration-700 ease-out hover:scale-105"
        format="webp"
      />
      {/* Мягкое градиентное затемнение снизу для читаемости текста */}
      <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-transparent" />

      {/* Заголовок в нижнем углу слева */}
      <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6">
        <h3 class="font-serif text-[22px] font-normal uppercase leading-snug text-white">
          Дома в сосновом бору
        </h3>
      </div>
    </div>
  </div>

  {/* Галерея 2х2 в стиле B2B с отступами и скруглёнными углами */}
  <div class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 pb-6 sm:px-6 lg:pb-10 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {
        gridItems.map(item => (
          <div class="relative block aspect-[16/9] w-full overflow-hidden rounded-2xl shadow-xs transition duration-300 hover:shadow-md md:rounded-3xl">
            <Image
              src={item.img}
              alt={item.title}
              class="h-full w-full object-cover transition duration-700 ease-out hover:scale-105"
              format="webp"
            />
            {/* Мягкое градиентное затемнение снизу для читаемости текста */}
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-transparent" />

            {/* Заголовок в нижнем углу без мелкого текста */}
            <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6">
              <h3 class="font-serif text-[22px] font-normal uppercase leading-snug text-white">
                {item.title}
              </h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
