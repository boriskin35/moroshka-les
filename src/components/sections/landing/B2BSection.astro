---
import { Image } from 'astro:assets';
import glampingImg from '@/assets/images/echo/echo_house_strict_architecture_1789728002236.jpg';
import cottagesImg from '@/assets/images/echo/echo-opushka-houses.jpg';
import resortImg from '@/assets/images/echo/echo-zhivitsa-bathhouse.jpg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const b2bCategories = [
  {
    title: 'ГЛЭМПИНГИ',
    image: glampingImg,
    alt: 'Глэмпинги из дерева в лесу МорошкаЛес',
  },
  {
    title: 'КОТТЕДЖНЫЕ ПОСЁЛКИ',
    image: cottagesImg,
    alt: 'Коттеджные посёлки из дерева под ключ',
  },
  {
    title: 'БАЗЫ ОТДЫХА',
    image: resortImg,
    alt: 'Базы отдыха и спа-комплексы из хвойного бруса',
  },
];
---

<section
  class:list={['w-full py-6 lg:py-10', className]}
  aria-label="Строительство для бизнеса"
>
  <!-- Шапка секции: заголовок и описание -->
  <div class="mb-6 lg:mb-8">
    <div>
      <p
        class="mb-2 text-xs font-bold tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
      >
        B2B-проекты
      </p>
      <h2
        class="font-serif text-[22px] font-normal uppercase leading-snug text-neutral-800 dark:text-neutral-200"
      >
        Строительство для <span class="text-accent">бизнеса</span>
      </h2>
      <p
        class="mt-2 text-base text-neutral-600 md:text-lg dark:text-neutral-400"
      >
        Создаём частные и коммерческие индивидуальные проекты под ключ.
      </p>
    </div>
  </div>

    <!-- Сетка из 3 фото-блоков: заголовок h2 в альбомной ориентации 16:9 -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        b2bCategories.map(item => (
          <div class="relative block aspect-[16/9] w-full overflow-hidden rounded-2xl shadow-xs transition duration-300 hover:shadow-md md:rounded-3xl">
            <Image
              src={item.image}
              alt={item.alt}
              class="h-full w-full object-cover transition duration-700 ease-out hover:scale-105"
              widths={[360, 600, 900]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            />
            {/* Мягкое градиентное затемнение снизу для читаемости текста */}
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent" />

            {/* Заголовок h2 в нижнем углу без плашки */}
            <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6">
              <h2 class="font-serif text-[22px] font-normal uppercase leading-snug text-white">
                {item.title}
              </h2>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Кнопка перехода в B2B -->
    <div class="mt-6 flex sm:mt-8">
      <a
        href="/b2b"
        class="group text-accent hover:text-accent-hover inline-flex items-center gap-x-2 text-base font-semibold transition duration-200"
      >
        <span>Подробнее о домах для бизнеса</span>
        <svg
          class="h-4 w-4 shrink-0 transition ease-in-out group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>
  </section>
