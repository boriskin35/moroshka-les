---
import patternImg from '@/assets/images/optimized/wood-pattern.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const steps = [
  {
    num: '1',
    title: 'Производство домокомплекта',
    text: 'Изготавливаем элементы дома на собственном производстве и подготавливаем к установке.',
  },
  {
    num: '2',
    title: 'Фундамент',
    text: 'Монтируем свайный фундамент, отсыпаем пятно застройки щебнем и монтируем перекрытие.',
  },
  {
    num: '3',
    title: 'Сборка дома на участке',
    text: 'Готовый домокомплект доставляем и с помощью крана собираем за 1–2 дня.',
  },
  {
    num: '4',
    title: 'Отделка и коммуникации',
    text: 'Монтируем внутренние сети, а также обшиваем дом снаружи и изнутри.',
  },
];
---

<section
  id="how"
  class:list={['w-full py-6 lg:py-10', className]}
  aria-label="Этапы строительства"
>
  <div class="mb-6 lg:mb-8">
    <p
      class="text-xs font-bold tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
    >
      Этапы строительства
    </p>
    <h2
      class="font-serif text-[22px] font-normal uppercase leading-snug text-neutral-800 dark:text-neutral-200 mt-3"
    >
      Как будет строиться <span class="text-accent">ваш будущий дом</span>
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2">
    {
      steps.map(step => (
        <div
          class="relative flex min-h-[160px] items-center justify-between overflow-hidden rounded-2xl p-6 shadow-xs sm:min-h-[190px] sm:rounded-3xl sm:p-8 lg:p-10"
          style={`background-color: #133e22; background-image: url('${patternImg.src}'); background-repeat: repeat; background-size: 320px 320px;`}
        >
          <div class="relative z-10 min-w-0 flex-1 pr-4">
            <h3 class="font-sans text-[22px] font-bold leading-snug text-white">
              {step.title}
            </h3>
            {
              step.text && (
                <p class="mt-2 font-sans text-sm leading-relaxed text-neutral-200/90 sm:mt-3 sm:text-base">
                  {step.text}
                </p>
              )
            }
          </div>
          <span
            class="relative z-10 shrink-0 select-none font-sans text-7xl font-bold leading-none text-white/35 sm:text-8xl md:text-8xl lg:text-9xl"
            aria-hidden="true"
          >
            {step.num}
          </span>
        </div>
      ))
    }
  </div>
</section>
