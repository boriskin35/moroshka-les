---
import Icon from '@components/ui/icons/Icon.astro';

const facts = [
  {
    icon: 'earth',
    title: 'Натуральные материалы',
    text: 'Используем кедр, проверенный временем.',
  },
  {
    icon: 'hammer',
    title: 'Собственное производство',
    text: 'Контроль качества на каждом этапе.',
  },
  {
    icon: 'house',
    title: 'Реальные испытания',
    text: 'Наши дома живут в «Эхо» — в реальных условиях, круглый год.',
  },
  {
    icon: 'checkCircle',
    title: 'Честный подход',
    text: 'Никаких скрытых расходов. Всё прозрачно — от проекта до заселения.',
  },
];
---

<section class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 2xl:max-w-full">
  <p class="mb-4 text-xs font-bold tracking-widest text-neutral-500 uppercase dark:text-neutral-400">
    Наши преимущества
  </p>
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-neutral-300 lg:grid-cols-4 dark:bg-neutral-700">
    {facts.map(item => (
      <div class="bg-neutral-200 p-4 lg:p-6 dark:bg-neutral-800">
        <span class="fact-icon text-accent">
          <Icon name={item.icon} />
        </span>
        <h3 class="mt-3 text-sm font-bold tracking-wide break-words text-neutral-800 uppercase dark:text-neutral-200">
          {item.title}
        </h3>
        <p class="mt-1 text-sm break-words text-neutral-600 dark:text-neutral-400">
          {item.text}
        </p>
      </div>
    ))}
  </div>
</section>
