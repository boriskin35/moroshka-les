---
import { Image } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';

const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  src,
  alt,
  mobileSrc,
  mobileAlt,
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  src?: any;
  alt?: string;
  mobileSrc?: any;
  mobileAlt?: string;
}
---

<section
  id="hero"
  class="dark relative isolate -mt-[104px] w-full overflow-hidden"
>
  <div
    id="hero-bg"
    class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
  >
    {
      src && alt && (
        <Image
          src={src}
          alt={alt}
          class="absolute inset-0 hidden h-full w-full object-cover object-center md:block"
          draggable={'false'}
          loading="eager"
          fetchpriority="high"
          format={'webp'}
        />
      )
    }
    {
      (mobileSrc || src) && (
        <Image
          src={mobileSrc || src}
          alt={mobileAlt || alt || ''}
          class="absolute inset-0 h-full w-full object-cover object-center md:hidden"
          draggable={'false'}
          loading="eager"
          fetchpriority="high"
          format={'webp'}
        />
      )
    }
  </div>

  <div
    class="relative z-10 mx-auto grid min-h-[calc(100vh_+_104px)] w-full max-w-(--breakpoint-2xl) items-end gap-4 px-4 pt-28 pb-[70px] sm:px-6 md:items-center md:pt-44 md:pb-24 lg:px-8"
  >
    <div class="text-on-image mx-auto w-full max-w-2xl text-left md:mx-0">
      <h1
        class="block text-left font-serif text-[24px] leading-snug font-normal tracking-wide text-neutral-50 uppercase md:text-[28px]"
      >
        <Fragment set:html={title} />
      </h1>

      {
        /* Мобильная белая плашка для текста и основной кнопки / на десктопе прозрачный блок */
      }
      <div
        class="mx-auto mt-[clamp(12px,3vh,24px)] w-full max-w-[calc(100vw-2rem)] sm:max-w-md rounded-2xl border border-white/50 bg-white/30 p-[clamp(12px,3.5vw,20px)] shadow-lg backdrop-blur-[2px] [-webkit-backdrop-filter:blur(2px)] md:mx-0 md:mt-0 md:max-w-none md:rounded-none md:border-none md:bg-transparent md:p-0 md:shadow-none md:backdrop-blur-none md:[-webkit-backdrop-filter:none]"
      >
        {
          subTitle && (
            <p class="mx-auto w-fit text-left text-sm leading-relaxed font-semibold text-neutral-950 [text-shadow:none] md:mx-0 md:mt-3 md:text-lg md:font-normal md:text-neutral-200 md:[text-shadow:inherit] lg:w-4/5">
              {subTitle.split('\n').map((line, idx, arr) => (
                <span>
                  {line}
                  {idx < arr.length - 1 && <br />}
                </span>
              ))}
            </p>
          )
        }
        {
          primaryBtn && (
            <div class="mt-4 flex justify-center md:hidden">
              <div class="w-[256px] *:w-full">
                <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />
              </div>
            </div>
          )
        }
      </div>

      {
        /* Кнопки: на мобильном только контурная кнопка ниже плашки, на десктопе обе кнопки в ряд */
      }
      <div
        class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row md:mt-7 md:justify-start"
      >
        {
          primaryBtn && (
            <div class="hidden md:inline-flex md:w-auto">
              <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />
            </div>
          )
        }
        {
          secondaryBtn && (
            <div class="flex justify-center md:mx-0 md:w-auto md:max-w-none md:px-0">
              <div class="w-[256px] *:w-full md:w-auto md:*:w-auto">
                <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
