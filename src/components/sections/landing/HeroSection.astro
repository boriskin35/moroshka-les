---
import { Image } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import ReviewComponent from '@components/ui/blocks/ReviewComponent.astro';

const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  withReview,
  avatars,
  starCount,
  rating,
  reviews,
  src,
  alt,
  mobileSrc,
  mobileAlt,
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
  src?: any;
  alt?: string;
  mobileSrc?: any;
  mobileAlt?: string;
}
---

<section id="hero" class="dark relative isolate -mt-[104px] w-full overflow-hidden">
  <div id="hero-bg" class="absolute inset-0 -z-20 overflow-hidden">
    {src && alt && (
      <Image
        src={src}
        alt={alt}
        class="absolute inset-0 hidden h-full w-full object-cover object-center md:block"
        draggable={'false'}
        loading="eager"
        fetchpriority="high"
        format={'avif'}
      />
    )}
    {(mobileSrc || src) && (
      <Image
        src={mobileSrc || src}
        alt={mobileAlt || alt || ''}
        class="absolute inset-0 h-full w-full object-cover object-center md:hidden"
        draggable={'false'}
        loading="eager"
        fetchpriority="high"
        format={'avif'}
      />
    )}
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/50 to-black/20"></div>

  <div class="mx-auto grid w-full max-w-(--breakpoint-2xl) min-h-[calc(100vh_+_104px)] min-h-[calc(100svh_+_104px)] items-center gap-4 px-4 pt-36 pb-24 sm:px-6 md:pt-44 lg:px-8">
    <div class="w-full max-w-2xl text-center md:mx-0 md:text-left">
      <h1
        class="block text-3xl font-bold tracking-tight text-balance text-neutral-50 sm:text-4xl lg:text-6xl lg:leading-tight"
      >
        <Fragment set:html={title} />
      </h1>
      {subTitle && (
        <p class="mx-auto mt-3 text-lg leading-relaxed text-pretty text-neutral-200 md:mx-0 lg:w-4/5">
          {subTitle.split('\n').map((line, idx, arr) => (
            <span>
              {line}
              {idx < arr.length - 1 && <br />}
            </span>
          ))}
        </p>
      )}
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row md:justify-start">
        {primaryBtn && <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />}
        {secondaryBtn && (
          <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />
        )}
      </div>

      {withReview ? (
        <ReviewComponent
          avatars={avatars}
          starCount={starCount}
          rating={rating}
          reviews={reviews}
        />
      ) : (
        ''
      )}
    </div>
  </div>
</section>
