---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';

const copy = {
  title: 'Оставьте заявку',
  subTitle: 'Посчитаем ваш дом за день.',
  formTitle: 'Заявка на расчёт',
  formSubTitle: 'Перезвоним в течение дня, ответим на вопросы.',
  firstName: 'Имя',
  lastName: 'Телефон',
  details: 'Опишите коротко суть вопроса',
  send: 'ОТПРАВИТЬ',
  knowledgeHeading: 'Позвоните нам',
  knowledgeContent: 'Ответим на вопросы по моделям, срокам и ценам.',
  knowledgeLink: '+7 982 511-15-35',
  tgHeading: 'Мы в Telegram',
  tgContent: 'Остались вопросы? Пишите — обсудим!',
  tgLink: '@JuliaM85',
  officeHeading: 'Адрес офиса',
  officeContent:
    '628007, г. Ханты-Мансийск, ул. Чехова, 82, корп. 1 (ТЦ «Еврострой»)',
  emailHeading: 'Написать нам',
  emailContent: 'Удобнее в мессенджере? Мы в MAX:',
};
---

<section class="w-full py-10 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="font-serif text-[24px] leading-snug font-normal text-neutral-800 uppercase dark:text-neutral-200"
      >
        Оставьте заявку
      </h1>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400">
        Посчитаем ваш дом за день.
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <form data-contact-form>
          <!-- Honeypot (ловушка для спам-ботов) -->
          <div class="hidden" aria-hidden="true">
            <label for="hs-hp-contact">Не заполняйте это поле</label>
            <input
              type="text"
              id="hs-hp-contact"
              name="hp_field"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4">
              <TextInput
                id="hs-firstname-contacts"
                label={copy.firstName}
                name="hs-firstname-contacts"
              />
            </div>
            <PhoneInput id="hs-phone-number" label="Телефон" />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="hs-about-contacts"
            />
          </div>

          <!-- Чекбокс согласия на обработку ПДн (152-ФЗ) -->
          <div class="mt-4 flex items-start gap-2.5 text-left">
            <div class="flex h-5 items-center">
              <input
                id="hs-privacy-consent"
                name="privacy-consent"
                type="checkbox"
                required
                class="text-accent focus:ring-accent h-4 w-4 shrink-0 cursor-pointer rounded border-neutral-400 transition-colors duration-200 dark:border-neutral-600 dark:bg-neutral-800 dark:focus:ring-offset-neutral-900"
              />
            </div>
            <label
              for="hs-privacy-consent"
              class="cursor-pointer text-xs leading-normal text-neutral-600 select-none dark:text-neutral-400"
            >
              Я даю согласие на <button
                type="button"
                data-hs-overlay="#hs-privacy-modal"
                class="cursor-pointer font-bold underline underline-offset-2 hover:text-neutral-800 dark:hover:text-neutral-200"
                >обработку персональных данных</button
              > в соответствии с Политикой конфиденциальности.
            </label>
          </div>

          <div class="mt-4 flex justify-center lg:block">
            <div class="w-[256px] lg:w-full">
              <AuthBtn title={copy.send} />
            </div>
          </div>

          <div class="mt-3 text-center">
            <p
              class="mt-3 hidden text-sm font-semibold transition-all duration-300"
              data-form-status
              aria-live="polite"
            >
            </p>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.knowledgeHeading}
          content={copy.knowledgeContent}
          isLinkVisible={true}
          linkTitle={copy.knowledgeLink}
          linkURL="tel:+79825111535"
          isArrowVisible={true}
          ><Icon name="phone" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle="Написать в MAX"
          linkURL="https://max.ru/u/f9LHodD0cOJZk_s8VSc9OCqBMqGwDRjR6fWRU84gj1nfTuquR8o6BgN9--4"
          target="_blank"
          rel="noopener"
          isArrowVisible={true}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.tgHeading}
          content={copy.tgContent}
          isLinkVisible={true}
          linkTitle="Написать в Telegram"
          linkURL="https://t.me/JuliaM85"
          target="_blank"
          rel="noopener"
          isArrowVisible={true}
          ><Icon name="telegram" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isLinkVisible={true}
          linkTitle="Смотреть на карте"
          linkURL="https://yandex.ru/maps/?text=ТЦ+Еврострой+Ханты-Мансийск+Чехова+82+корп.+1"
          target="_blank"
          rel="noopener"
          isArrowVisible={true}
          ><Icon name="mapPin" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
