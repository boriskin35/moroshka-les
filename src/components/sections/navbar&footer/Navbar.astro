---
import NavLink from '@components/ui/links/NavLink.astro';
import BrandLogo from '@components/BrandLogo.astro';
import enStrings from '@utils/navigation.ts';

const strings = enStrings;
const homeUrl = '/';
---

<header
  class="sticky inset-x-0 top-4 z-50 flex w-full flex-wrap text-sm md:flex-nowrap md:justify-start"
>
  <nav
    class="relative mx-2 w-full rounded-[36px] border border-neutral-200/80 bg-white/90 px-3.5 py-2 shadow-xs backdrop-blur-md sm:px-4 sm:py-2.5 md:flex md:min-h-[58px] md:items-center md:justify-between md:px-6 md:py-0 lg:px-8 xl:mx-auto"
    aria-label="Global"
  >
    <div class="flex items-center justify-between">
      <a
        class="flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3"
        href={homeUrl}
        aria-label="МорошкаЛес"
      >
        <BrandLogo class="h-7 w-auto sm:h-8 md:h-9" loading="eager" fetchpriority="high" />
      </a>

      <!-- Мобильные действия: кнопки контактов с заливкой и прозрачный бургер -->
      <div class="flex items-center gap-1 sm:gap-1.5 md:hidden">
        <a
          href="tel:+79825111535"
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[#133e22] text-white shadow-xs transition duration-200 hover:bg-[#1c552f] hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-accent outline-hidden sm:h-8 sm:w-8"
          aria-label="Позвонить нам"
          title="Позвонить: +7 982 511-15-35"
        >
          <svg
            class="h-3 w-3 sm:h-3.5 sm:w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
            />
          </svg>
        </a>

        <a
          href="https://t.me/JuliaM85"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[#24A1DE] text-white shadow-xs transition duration-200 hover:bg-[#1e8ec5] hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-accent outline-hidden sm:h-8 sm:w-8"
          aria-label="Написать в Telegram"
          title="Написать в Telegram"
        >
          <svg class="h-3 w-3 fill-current -translate-x-[0.5px] translate-y-[0.5px] sm:h-3.5 sm:w-3.5" viewBox="0 0 24 24">
            <path
              d="m20.665 3.717-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.313 4.67c.458 0 .66-.21.916-.457l2.199-2.138 4.574 3.38c.843.465 1.45.225 1.66-.782l3-14.13c.307-1.23-.468-1.786-1.272-1.42z"
            />
          </svg>
        </a>

        <a
          href="https://max.ru/u/f9LHodD0cOJZk_s8VSc9OCqBMqGwDRjR6fWRU84gj1nfTuquR8o6BgN9--4"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-7 w-7 items-center justify-center rounded-full bg-[#7A27FF] text-white shadow-xs transition duration-200 hover:bg-[#681ae6] hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-accent outline-hidden sm:h-8 sm:w-8"
          aria-label="Написать в MAX"
          title="Написать в MAX"
        >
          <svg
            class="h-3.5 w-3.5 fill-current sm:h-4 sm:w-4"
            viewBox="0 0 1000 1000"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M508.211 878.328c-75.007 0-109.864-10.95-170.453-54.75-38.325 49.275-159.686 87.783-164.979 21.9 0-49.456-10.95-91.248-23.36-136.873-14.782-56.21-31.572-118.807-31.572-209.508 0-216.626 177.754-379.597 388.357-379.597 210.785 0 375.947 171.001 375.947 381.604.707 207.346-166.595 376.118-373.94 377.224m3.103-571.585c-102.564-5.292-182.499 65.7-200.201 177.024-14.6 92.162 11.315 204.398 33.397 210.238 10.585 2.555 37.23-18.98 53.837-35.587a189.8 189.8 0 0 0 92.71 33.032c106.273 5.112 197.08-75.794 204.215-181.95 4.154-106.382-77.67-196.486-183.958-202.574Z"
            />
          </svg>
        </a>

        <!-- Кнопка бургера в прозрачном кружочке -->
        <button
          type="button"
          id="navbar-menu-toggle"
          class="flex h-7 w-7 flex-col items-center justify-center gap-[3px] rounded-full border border-neutral-300 bg-transparent text-neutral-700 transition duration-200 hover:border-neutral-400 hover:bg-neutral-100 hover:text-neutral-900 disabled:pointer-events-none disabled:opacity-50 focus-visible:ring-2 focus-visible:ring-accent outline-hidden sm:h-8 sm:w-8"
          aria-label="Открыть меню"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <span
            class="navbar-burger-line block h-0.5 w-3.5 rounded-full bg-current"
          ></span>
          <span
            class="navbar-burger-line block h-0.5 w-3.5 rounded-full bg-current"
          ></span>
          <span
            class="navbar-burger-line block h-0.5 w-3.5 rounded-full bg-current"
          ></span>
        </button>
      </div>
    </div>

    <!-- Десктопное меню -->
    <div class="hidden grow basis-full md:block">
      <div
        class="mt-5 flex flex-col gap-x-0 gap-y-4 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-x-4 md:gap-y-0 md:ps-7 lg:gap-x-7"
      >
        {
          strings.navBarLinks.map(link => (
            <NavLink url={link.url} name={link.name} />
          ))
        }

        <!-- Кнопка с номером телефона -->
        <a
          href="tel:+79825111535"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-neutral-300 bg-neutral-50 text-sm font-semibold text-neutral-800 shadow-2xs transition duration-200 hover:border-neutral-400 hover:bg-neutral-100 hover:text-neutral-950 focus-visible:ring-2 focus-visible:ring-accent outline-hidden lg:h-auto lg:w-auto lg:gap-x-2 lg:px-3.5 lg:py-1.5"
          title="Позвонить: +7 982 511-15-35"
          aria-label="Позвонить нам"
        >
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#133e22] text-white">
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
              />
            </svg>
          </span>
          <span class="hidden lg:inline">+7 982 511-15-35</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<div
  id="navbar-modal"
  class="fixed inset-0 z-40 hidden md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Меню"
>
  <div
    id="navbar-modal-backdrop"
    class="absolute inset-0 bg-neutral-950/20 opacity-0 backdrop-blur-md transition-opacity duration-300"
  >
  </div>
  <div
    id="navbar-modal-panel"
    data-lenis-prevent
    class="absolute inset-x-2 top-[80px] max-h-[calc(100dvh-96px)] origin-top scale-y-50 overflow-y-auto rounded-[28px] border border-neutral-200 bg-white/95 p-4 opacity-0 shadow-xl backdrop-blur-md transition-all duration-300 ease-out"
  >
    <nav class="flex flex-col divide-y divide-neutral-200/70">
      {
        strings.navBarLinks.map(link => (
          <a
            href={link.url}
            data-astro-prefetch
            data-navbar-modal-link
            class="group flex items-center justify-between rounded-xl px-3 py-3.5 text-lg font-medium text-neutral-800 outline-hidden transition duration-200 hover:bg-neutral-100/70 hover:text-accent focus-visible:ring-2 focus-visible:ring-accent"
          >
            <span class="text-left">{link.name}</span>
            {link.url === '/' && (
              <svg
                class="size-5 shrink-0 text-neutral-400 transition duration-200 group-hover:text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 12l8.954-8.955a1.125 1.125 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
                />
              </svg>
            )}
            {link.url === '/catalog' && (
              <svg
                class="size-5 shrink-0 text-neutral-400 transition duration-200 group-hover:text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
                />
              </svg>
            )}
            {link.url === '/blog' && (
              <svg
                class="size-5 shrink-0 text-neutral-400 transition duration-200 group-hover:text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                />
              </svg>
            )}
            {link.url === '/b2b' && (
              <svg
                class="size-5 shrink-0 text-neutral-400 transition duration-200 group-hover:text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008Z"
                />
              </svg>
            )}
            {link.url === '/contact' && (
              <svg
                class="size-5 shrink-0 text-neutral-400 transition duration-200 group-hover:text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25Z"
                />
              </svg>
            )}
          </a>
        ))
      }
    </nav>
    <a
      href="/contact"
      data-navbar-modal-link
      class="bg-accent hover:bg-accent-hover mt-3 block rounded-2xl px-4 py-3.5 text-center text-base font-bold text-white uppercase transition duration-200"
    >
      Оставить заявку
    </a>
  </div>
</div>

<style>
  #navbar-menu-toggle .navbar-burger-line {
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
    transform-origin: center;
  }
  #navbar-menu-toggle.open .navbar-burger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  #navbar-menu-toggle.open .navbar-burger-line:nth-child(2) {
    opacity: 0;
  }
  #navbar-menu-toggle.open .navbar-burger-line:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script>
  const modal = document.getElementById('navbar-modal');
  const toggleBtn = document.getElementById('navbar-menu-toggle');
  const backdrop = document.getElementById('navbar-modal-backdrop');
  const panel = document.getElementById('navbar-modal-panel');
  const lenis = (window as any).__moroshkaLenis;
  let closeTimer: number | undefined;

  const hiddenPanelClasses = ['opacity-0', 'scale-y-50'];

  function isInScrollablePanel(event: Event) {
    return !!(event.target as HTMLElement).closest?.('[data-lenis-prevent]');
  }

  function blockScrollEvent(event: Event) {
    if (!isInScrollablePanel(event)) event.preventDefault();
  }

  function blockScrollKeys(event: KeyboardEvent) {
    const keys = [
      ' ',
      'ArrowUp',
      'ArrowDown',
      'PageUp',
      'PageDown',
      'Home',
      'End',
    ];
    if (keys.includes(event.key) && !isInScrollablePanel(event)) {
      event.preventDefault();
    }
  }

  // NOTE: do NOT use body { overflow: hidden } here — it breaks
  // position: sticky on the header (menu opens without the navbar).
  function lockScroll() {
    if (lenis) lenis.stop();
    document.addEventListener('wheel', blockScrollEvent, { passive: false });
    document.addEventListener('touchmove', blockScrollEvent, {
      passive: false,
    });
    document.addEventListener('keydown', blockScrollKeys);
  }

  function unlockScroll() {
    if (lenis) lenis.start();
    document.removeEventListener('wheel', blockScrollEvent);
    document.removeEventListener('touchmove', blockScrollEvent);
    document.removeEventListener('keydown', blockScrollKeys);
  }

  function openMenu() {
    window.clearTimeout(closeTimer);
    modal?.classList.remove('hidden');
    // Force reflow so the transition runs from the hidden state.
    void modal?.offsetWidth;
    backdrop?.classList.remove('opacity-0');
    panel?.classList.remove(...hiddenPanelClasses);
    toggleBtn?.classList.add('open');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    toggleBtn?.setAttribute('aria-label', 'Закрыть меню');
    lockScroll();
  }

  function closeMenu() {
    if (modal?.classList.contains('hidden')) return;
    backdrop?.classList.add('opacity-0');
    panel?.classList.add(...hiddenPanelClasses);
    toggleBtn?.classList.remove('open');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    toggleBtn?.setAttribute('aria-label', 'Открыть меню');
    unlockScroll();
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => {
      modal?.classList.add('hidden');
    }, 300);
  }

  function toggleMenu() {
    if (modal?.classList.contains('hidden')) openMenu();
    else closeMenu();
  }

  toggleBtn?.addEventListener('click', toggleMenu);
  backdrop?.addEventListener('click', closeMenu);
  modal?.querySelectorAll('[data-navbar-modal-link]').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeMenu();
    }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', event => {
    if (event.matches) closeMenu();
  });
</script>
